PORT=4000
NODE_ENV=development

# Firma de tokens. Sin esto el server NO arranca en produccion.
JWT_SECRET=cambia_este_secreto_en_produccion
JWT_EXPIRES_IN=7d

# --- CORS ---
# Origen del frontend. En produccion poner el dominio real, NO localhost.
# Acepta varios separados por coma.
FRONTEND_URL=http://localhost:5173
# Orígenes extra exactos (opcional, lista separada por coma).
# ALLOWED_ORIGINS=
# Regex para preview deployments (opcional, lista separada por coma).
# Vacio por defecto: no hay ningun comodin activo. Ejemplo acotado al proyecto:
# ALLOWED_ORIGIN_PATTERNS=^https://compushop-dun-[a-z0-9]+\.vercel\.app$

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Compushop <noreply@compushop.com>
CONTACT_TO=contacto@compushop.com

# --- BASE DE DATOS (Postgres) ---
# URL de conexión al pooler de Supabase (transaction mode).
# IMPORTANTE: usar PUERTO 6543 (pooler transaction) y host del pooler, NO el direct.
# NUNCA agregues sslmode= ni sslrootcert= en la URL: esos parámetros son de libpq
# y la librería pg de Node los ignora en silencio. La verificación TLS real se hace
# mediante el objeto ssl en src/data/postgres/pool.js.
# La contraseña DEBE estar percent-encoded en la URL (si empieza con @ corta el parseo
# del hostname y el error aparenta ser de credenciales).
DATABASE_URL=postgresql://compushop_app.<PROJECT_REF>:<PASSWORD_PERCENT_ENCODED>@aws-0-us-west-2.pooler.supabase.com:6543/postgres

# Solo desarrollo/local. NUNCA se utiliza en Vercel.
# Base de pruebas aislada para la suite (tests corren con el rol de la app).
DATABASE_TEST_URL=postgresql://compushop_test.<PROJECT_REF>:<PASSWORD_PERCENT_ENCODED>@aws-0-us-west-2.pooler.supabase.com:6543/postgres

# Certificado CA de Supabase (PEM completo, multilínea) para verificar la cadena TLS.
# En PRODUCCIÓN es OBLIGATORIO: pool.js exige SUPABASE_CA_CERT y falla al iniciar si falta.
# Descarga: Supabase → Database → Settings → Connection info → Download certificate (Root CA).
# SIN CA NO HAY VERIFICACIÓN DEL SERVIDOR (rejectUnauthorized true solo con CA válida).
# No pongas el contenido real aquí: usar solo placeholder.
SUPABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n<PEM_MULTILINEA_DEL_CA>\n-----END CERTIFICATE-----"

# --- CRON / KEEP-WARM ---
# Secreto aleatorio >= 16 caracteres. Usado por Vercel Cron como Bearer en Authorization
# para llamar a /api/health/keep-warm. SIN este secreto, el endpoint devuelve 503 y NO
# ejecuta ninguna query (protección anti-DoS). Nunca hardcodeado en código.
CRON_SECRET=<CRON_SECRET_ALEATORIO_MIN_16_CHARS>
