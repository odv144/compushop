PORT=4000
NODE_ENV=development

# Firma de tokens. Sin esto el server NO arranca en produccion.
JWT_SECRET=cambia_este_secreto_en_produccion
JWT_EXPIRES_IN=7d

# --- CORS ---
# Origen del frontend. En produccion poner el dominio real, NO localhost.
# Acepta varios separados por coma.
FRONTEND_URL=http://localhost:5173
# Orígenes extra exactos (opcional, lista separada por coma).
# ALLOWED_ORIGINS=
# Regex para preview deployments (opcional, lista separada por coma).
# Vacio por defecto: no hay ningun comodin activo. Ejemplo acotado al proyecto:
# ALLOWED_ORIGIN_PATTERNS=^https://compushop-dun-[a-z0-9]+\.vercel\.app$

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Compushop <noreply@compushop.com>
CONTACT_TO=contacto@compushop.com
